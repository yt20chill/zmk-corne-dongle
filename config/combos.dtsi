#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

// left horizontal shortcuts
ZMK_COMBO(term_copy, &kp LG(LS(C)), LT3 LT2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(term_paste, &kp LG(LS(V)), LT2 LT1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(copy, &kp LG(C), LB3 LB2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(paste, &kp LG(V), LB2 LB1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(cut, &kp LG(X), LB3 LB1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// right horizontal shortcuts
ZMK_COMBO(lpar, &kp LPAR, RT2 RT3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rpar, &kp RPAR, RT3 RT4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbkt, &kp LBKT, RM2 RM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt, &kp RBKT, RM3 RM4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbrc, &kp LBRC, RB2 RB3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc, &kp RBRC, RB3 RB4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// left vertical shortcuts
ZMK_COMBO(pipe, &kp PIPE, LT1 LM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(bslh, &kp BSLH, LB1 LM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(at, &kp AT, LT2 LM2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(caret, &kp CARET, LB2 LM2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(hash, &kp HASH, LT3 LM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(prcnt, &kp PRCNT, LB3 LM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(dllr, &kp DLLR, LT4 LM4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(grave, &kp GRAVE, LM5 LB5, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(tilde, &kp TILDE, LT5 LM5, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)


// right vertical shortcuts
ZMK_COMBO(amps, &kp AMPS, RT1 RM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(fslh, &kp FSLH, RB1 RM1, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(astrk, &kp ASTRK, RT2 RM2, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(plus, &kp PLUS, RT3 RM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(eq, &kp EQUAL, RB3 RM3, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(colon, &kp COLON, RT4 RM4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)
ZMK_COMBO(semi, &kp SEMI, RB4 RM4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_SLOW)


// symmetric shortcuts
ZMK_COMBO(esc, &kp ESC, LM4 RM4, DEF NAV NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST) // home pinkies
ZMK_COMBO(caps_word, &caps_word, LB4 RB4, DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)    // bottom pinkies