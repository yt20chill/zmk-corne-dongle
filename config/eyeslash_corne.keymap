#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>

// urobs helpers
#include <behaviors/num_word.dtsi>  // requires zmk-auto-layer module
#include <zmk-helpers/helper.h> // requires zmk-helpers module
#include "eyelash42.h"   // before dt-bindings/keys.h

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define DEF 0
#define SYM 1
#define NUM 2
#define NAV 3
#define FUN 4

#define XXX &none
#define ___ &trans

#define QUICK_TAP_MS 175

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

&sl { // Allow sticky mods to chord across sticky layers.
  ignore-modifiers;
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off {
    hold-time-ms = <3000>;   // only turn off if the key is held for 3 s or longer
};

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS)                                 \
  ZMK_HOLD_TAP(NAME, bindings = <HOLD>, <TAP>; flavor = "balanced";            \
               tapping-term-ms = <280>; quick-tap-ms = <QUICK_TAP_MS>;         \
               require-prior-idle-ms = <150>; hold-trigger-on-release;         \
               hold-trigger-key-positions = <TRIGGER_POS>;)

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS) // Left-hand HRMs.
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS) // Right-hand HRMs.

// Hack: Make HRM combos tap-only
#define ZMK_COMBO_8(NAME, TAP, POS, LAYERS, COMBO_MS, IDLE_MS, HOLD, SIDE)     \
  MAKE_HRM(hm_combo_##NAME, &kp, TAP, SIDE THUMBS)                             \
  ZMK_COMBO_6(NAME, &hm_combo_##NAME HOLD 0, POS, LAYERS, COMBO_MS, IDLE_MS)


ZMK_HOLD_TAP(ht, bindings = <&kp>, <&kp>; flavor = "balanced";                \
             tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;          \
             require-prior-idle-ms = <150>;)

// smart_num = CAPS_WORD on num
// Tap: num-word | double-tap: sticky num-layer | Hold: num-layer.
#define SMART_NUM &smart_num NUM 0
ZMK_HOLD_TAP(smart_num, bindings = <&mo>, <&num_dance>; flavor = "balanced";
             tapping-term-ms = <200>; quick-tap-ms = <QUICK_TAP_MS>;)
ZMK_TAP_DANCE(num_dance, bindings = <&num_word NUM>, <&sl NUM>;
              tapping-term-ms = <200>;)


// left vertical shortcuts
ZMK_COMBO(term_copy, &kp LG(LS(C)), LT3 LT2) // top ring + middle
ZMK_COMBO(term_paste, &kp LG(LS(V)), LT2 LT1)    // top middle + index
ZMK_COMBO(copy, &kp LG(C), LB3 LB2)  // bottom ring + middle
ZMK_COMBO(paste, &kp LG(V), LB2 LB1) // bottom middle + index
ZMK_COMBO(cut, &kp LG(X), LB3 LB1)   // bottom ring + index

// symmetric shortcuts
ZMK_COMBO(esc, &kp ESC, LM4 RM4) // home pinkies
ZMK_COMBO(caps_word, &caps_word, LB4 RB4)    // bottom pinkies

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "GALLIUM";
            bindings = <
    XXX  &kp B         &kp L        &kp D         &kp C          &kp V                              XXX                 &kp J          &kp Y          &kp O         &kp U         &kp SQT     XXX
    XXX  &hml LCTRL N  &hml LALT R  &hml LGUI T   &hml LSHIFT S  &kp G                    XXX     XXX      XXX      &kp P          &hmr RSHIFT H  &hmr RGUI A   &hmr RALT E   &hmr RCTRL I  XXX
    XXX  &kp X         &kp Q        &kp M         &kp W          &kp Z       XXX                  XXX                 &kp K          &kp F          &kp COMMA     &kp DOT       &kp FSLH      XXX
                                 &kp ESC       &lt NAV SPACE         &lt NUM MINUS                                                     &lt SYM ENTER      &kp BSPC          &kp TAB
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
    XXX  &kp GRAVE  &kp TILDE  &kp HASH   &kp AMPS   &kp PIPE                       XXX             &kp CARET  &kp LBRC   &kp RBRC   &kp LBKT   &kp RBKT  XXX
    XXX  &kp EXCL   &kp UNDER  &kp COLON  &kp EQUAL  &kp DLLR                XXX  XXX  XXX      &kp AT     &kp LPAR   &kp RPAR   &kp UNDER  &kp SEMI  XXX
    XXX  &kp PRCNT  &kp QMARK  &kp ASTRK  &kp PLUS   &kp BSLH  XXX                XXX             &kp FSLH   &kp MINUS  &kp LT     &kp GT     &kp DQT   XXX
                                    ___     ___     &mo FUN                               ___     ___     ___
                >;
            };

        num_layer {
            display-name = "NUM";
            bindings = <
    XXX  XXX        XXX  XXX   XXX      XXX                              XXX                 &kp FSLH         &kp N7   &kp N8   &kp N9   &kp ASTRK       XXX
    XXX  XXX        XXX  XXX   &kp LSHIFT XXX                    XXX     XXX      XXX      &kp DOT          &kp N4   &kp N5   &kp N6   &kp MINUS        XXX
    XXX  XXX        XXX  XXX   XXX      XXX    XXX                     XXX                 &ht COMMA UNDER  &kp N1   &kp N2   &kp N3   &ht PLUS EQUAL  XXX
                                     ___          ___          ___                        &mo FUN          ___          &kp 0
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
    XXX  &kp CARET      XXX       XXX      &kp DOLLAR      XXX                                XXX                 XXX         &kp LBRC         &kp RBRC        &kp LBKT       &kp RBKT        XXX
    XXX  &kp LCTRL     &kp LALT    &kp LGUI    &kp LSHIFT    &kp PRCNT                    XXX     XXX      XXX      XXX      &kp LEFT      &kp DOWN     &kp UP      &kp RIGHT    XXX
    XXX  XXX         XXX        XXX      XXX         XXX       XXX                      XXX                 XXX         &kp LA(LEFT_ARROW)      &kp PG_DN    &kp PG_UP   &kp LA(RIGHT_ARROW)      XXX
                                        ___       ___        ___                                                ___        ___        ___
                >;
            };

        fun_layer {
            display-name = "FUN";
            bindings = <
    XXX  &kp F1    &kp F2        &kp F3        &kp F4        &kp F5                                       XXX                 &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       XXX
    XXX  &kp F11   &rgb_ug RGB_BRI   &rgb_ug RGB_BRD     &rgb_ug RGB_TOG   &rgb_ug RGB_EFF      XXX     XXX  XXX          XXX        XXX       XXX         XXX         &kp F12       XXX
    XXX  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bootloader XXX                        XXX                 &bootloader   &soft_off    &bt BT_CLR     &rgb_ug RGB_COLOR_HSB(190,100,10)              XXX         XXX
                                    ___        ___        ___                                                      ___        ___        ___
            >;
        };
    };
};